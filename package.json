{
  "name": "sandustry-mod-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "bash scripts/dev.sh",
    "watch": "bash scripts/dev.sh",
    "typecheck": "tsc --noEmit",
    "generate-types": "node scripts/generate-api-types.mjs",
