{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "lib": ["ES2021", "DOM"],
    "types": ["react", "node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "*": ["./*"],
      "@modkit/*": ["./modkit/*"]
    }
  },
  "include": ["modkit", "src", "examples", "mods"]
}
