# Copy to `.env` and edit.

# Sandustry binary. Commented = auto-detect from Steam libraries.
# SANDUSTRY= # /path/to/sandustry | C:\...\Sandustry.exe

# Watch policy for `npm run dev` → dist/ (OS mods folder).
# selection = last F5 / npm run dev:pick set (default)
# all = every src/ and mods/ folder
DEV_MODS=selection # selection | all

# Companion folders always compiled with the F5 / selection set.
# DEV_ALWAYS_MODS=template

# Remove template-owned mods from dist/ when `npm run dev` stops.
DEV_CLEANUP=false # false keep installed | true remove on stop

# Renderer CDP port for F5 / Steam attach.
# SANDUSTRY_RENDERER_DEBUG_PORT=9222 # 9222 Steam/F5 | 9224 integration tests
