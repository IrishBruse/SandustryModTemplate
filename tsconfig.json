{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM"],
    "types": ["react"],
    "paths": {
      "*": ["./*"],
      "@modkit/*": ["./modkit/*"],
      "types/*": ["./types/*"]
    }
  },
  "include": ["src", "modkit", "mod.ts", "types"]
}
