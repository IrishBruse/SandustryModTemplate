{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM"],
    "types": ["react"],
    "paths": {
      "*": ["./*"],
      "@modkit/*": ["./modkit/*"],
      "types/api": ["./modkit/types/src/main/index"],
      "types/worker-api": ["./modkit/types/src/worker/index"],
      "types/sandkit": ["./modkit/types/src/main/index"],
      "types/engine": ["./modkit/types/src/engine/index"],
      "types/*": ["./modkit/types/*"]
    }
  }
}
