{
  "include": ["./**/*.d.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": false,
    "strict": true,
    "types": ["react"],
    "forceConsistentCasingInFileNames": true
  }
}
