{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sandustry Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": ["${workspaceFolder}/scripts/sandustry/sandustry-vscode-launch.js"],
      "outputCapture": "std",
      "timeout": 120000,
      "autoAttachChildProcesses": true
    },
    {
      "name": "Sandustry Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/dist/**",
        "${userHome}/.config/sandustry/mods/**",
        "${env:APPDATA}/sandustry/mods/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "/~/*": "${userHome}/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///./~/*": "${userHome}/*"
      },
      "timeout": 120000
    },
    {
      "name": "Sandustry: Attach (npm run sandustry:vscode)",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "timeout": 120000
    },
    {
      "name": "Sandustry Renderer: Attach (npm run sandustry:vscode)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/dist/**",
        "${userHome}/.config/sandustry/mods/**",
        "${env:APPDATA}/sandustry/mods/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "/~/*": "${userHome}/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///./~/*": "${userHome}/*"
      },
      "timeout": 120000
    }
  ],
  "compounds": [
    {
      "name": "Sandustry",
      "configurations": ["Sandustry Main", "Sandustry Renderer"],
      "preLaunchTask": "sandustry:prepare-debug",
      "stopAll": true,
      "presentation": {
        "order": 1,
        "group": "sandustry"
      }
    },
    {
      "name": "Sandustry: Attach Main + Renderer (npm run sandustry:vscode)",
      "configurations": [
        "Sandustry: Attach (npm run sandustry:vscode)",
        "Sandustry Renderer: Attach (npm run sandustry:vscode)"
      ],
      "preLaunchTask": "sandustry:vscode-background",
      "stopAll": true,
      "presentation": {
        "order": 2,
        "group": "sandustry"
      }
    }
  ]
}
