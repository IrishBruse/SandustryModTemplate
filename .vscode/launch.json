{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sandustry Main",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9230,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "restart": true,
      "timeout": 120000,
      "presentation": {
        "hidden": true,
        "group": "sandustry",
        "order": 2
      }
    },
    {
      "name": "Sandustry Renderer",
      "type": "chrome",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "urlFilter": "*app.asar/dist/index.html*",
      "sourceMaps": true,
      "enableContentValidation": false,
      "pauseForSourceMap": true,
      "resolveSourceMapLocations": [
        "sandkit-workshop://**",
        "${workspaceFolder}/**",
        "${workspaceFolder}/dist/**",
        "${userHome}/.config/sandustry/mods/**",
        "${env:APPDATA}/sandustry/mods/**",
        "!**/node_modules/**"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${userHome}/.config/sandustry/mods/**/*.js",
        "${env:APPDATA}/sandustry/mods/**/*.js"
      ],
      "timeout": 120000,
      "presentation": {
        "hidden": true,
        "group": "sandustry",
        "order": 1
      }
    }
  ],
  "compounds": [
    {
      "name": "Sandustry",
      "configurations": ["Sandustry Renderer", "Sandustry Main"],
      "preLaunchTask": "sandustry:launch-debug",
      "postDebugTask": "sandustry:stop",
      "stopAll": true,
      "presentation": {
        "order": 1,
        "group": "sandustry"
      }
    },
    {
      "name": "Sandustry: Attach Main + Renderer (build + launch)",
      "configurations": ["Sandustry Renderer", "Sandustry Main"],
      "preLaunchTask": "sandustry:vscode-background",
      "postDebugTask": "sandustry:stop",
      "stopAll": true,
      "presentation": {
        "order": 2,
        "group": "sandustry"
      }
    }
  ]
}
