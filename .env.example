# Copy to `.env` and edit. Existing shell env wins over this file.
# Format: KEY=value # other options

# Sandustry binary. Empty = auto-detect from Steam libraries.
SANDUSTRY= # /path/to/sandustry | C:\...\Sandustry.exe

# Which mods `npm run dev` compiles into dist/ (OS mods folder).
# all = every src/ and mods/ folder
# selection = last F5 / npm run dev:pick set only
# folder list = those folders always, plus the F5 / selection set
DEV_MODS=selection # all | selection | irishbruse.pick-block,irishbruse.dev-tools

# Remove template-owned mods from dist/ when `npm run dev` stops.
DEV_CLEANUP=false # false keep installed | true remove on stop

# Renderer CDP port for F5 / Steam attach.
SANDUSTRY_RENDERER_DEBUG_PORT=9222 # 9222 Steam/F5 | 9224 integration tests

# VS Code preLaunchTask: spawn Sandustry then exit so attach can connect.
SANDUSTRY_DEBUG_DETACHED=false # false keep launcher alive | true background then exit

# Foreground launch helper (launch-sandustry-vscode.js).
SANDUSTRY_DEBUG_FOREGROUND=false # false detached spawn | true spawnSync in terminal
