{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM"],
    "types": ["react"],
    "paths": {
      "*": ["./*"],
      "@modkit/*": ["./modkit/*"],
      "types/api": ["./types/src/sandkit/api/sandkit-api"],
      "types/worker-api": ["./types/src/worker/sandkit-api"],
      "types/sandkit": ["./types/src/sandkit"],
      "types/engine": ["./types/src/sandkit/engine"],
      "types/enums": ["./types/src/sandkit/enums"],
      "types/*": ["./types/*"]
    }
  }
}
