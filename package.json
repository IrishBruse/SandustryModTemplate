{
  "name": "sandustry-mod-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build/esbuild.config.mjs",
    "dev": "node scripts/build/dev.js",
    "typecheck": "node scripts/build/typecheck.js",
    "mod:install": "node scripts/build/install-mod-deps.js",
    "postinstall": "node scripts/build/install-mod-deps.js",
    "lint": "npm run typecheck && oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "docs": "docsify serve docs",
    "setup": "node scripts/sandustry/setup.js",
    "ui:css": "node scripts/ui/compile-preview-css.mjs",
    "ui:previews": "node scripts/ui/generate-previews.mjs",
    "sandustry": "node scripts/sandustry/launch-sandustry.js",
    "sandustry:vscode": "node scripts/sandustry/launch-sandustry-vscode.js"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@types/react": "^18.3.1",
    "docsify-cli": "^5.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
